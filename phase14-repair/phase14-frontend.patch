+// ---------------------------------------------------------------------------
+// Phase 14 — annual summary (mirror of `commands/bilan.rs`)
+// ---------------------------------------------------------------------------
+
+const FRENCH_MONTHS = [
+  'Janvier',
+  'Février',
+  'Mars',
+  'Avril',
+  'Mai',
+  'Juin',
+  'Juillet',
+  'Août',
+  'Septembre',
+  'Octobre',
+  'Novembre',
+  'Décembre',
+];
+
+/** `YYYY-MM-DD` of a timestamp or date string. */
+const isoDay = (value: string | null | undefined): string => (value ?? '').slice(0, 10);
+
+const inRange = (day: string, from: string, to: string): boolean => day >= from && day <= to;
+
+/** Months of a year range, capped at 24 like the Rust side. */
+function monthsBetween(from: string, to: string): Array<{ month: number; year: number }> {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(from) || !/^\d{4}-\d{2}-\d{2}$/.test(to)) return [];
+  const [startYear, startMonth] = from.split('-').map(Number);
+  const months: Array<{ month: number; year: number }> = [];
+  let year = startYear;
+  let month = startMonth;
+  while (months.length < 24) {
+    const first = `${String(year).padStart(4, '0')}-${String(month).padStart(2, '0')}-01`;
+    if (first > to) break;
+    months.push({ month, year });
+    if (month === 12) {
+      month = 1;
+      year += 1;
+    } else {
+      month += 1;
+    }
+  }
+  return months;
+}
+
+/** Every number of one school year, computed exactly like `bilan.rs`. */
+function computeBilan(store: DevStore, year: SchoolYear): BilanData {
+  const from = (year.start_date ?? '').slice(0, 10) || `${new Date().getFullYear()}-01-01`;
+  const to = (year.end_date ?? '').slice(0, 10) || `${new Date().getFullYear()}-12-31`;
+
+  const yearGroups = store.groups.filter((group) => group.school_year_id === year.id);
+  const yearGroupIds = new Set(yearGroups.map((group) => group.id));
+  const yearEnrollments = store.enrollments.filter((enrollment) =>
+    yearGroupIds.has(enrollment.group_id),
+  );
+
+  const totalStudents = new Set(yearEnrollments.map((enrollment) => enrollment.student_id)).size;
+
+  const monthInRange = (month: number | null, monthYear: number | null): boolean => {
+    if (month === null || monthYear === null) return false;
+    const first = `${String(monthYear).padStart(4, '0')}-${String(month).padStart(2, '0')}-01`;
+    return first >= from && first <= to;
+  };
+  // Invoices billed inside the range — the same twelve months as the revenue,
+  // so the collection rate can never pass 100 % because of an older year.
+  const theoretical = store.invoices
+    .filter((invoice) =>
+      monthInRange(invoice.period_month ?? null, invoice.period_year ?? null),
+    )
+    .reduce((sum, invoice) => sum + invoice.amount_cents, 0);
+
+  const paymentsInRange = store.payments.filter((payment) =>
+    inRange(isoDay(payment.created_at), from, to),
+  );
+  const revenue = paymentsInRange.reduce((sum, payment) => sum + payment.amount_cents, 0);
+
+  const compensation = store.teacherSettlements
+    .filter((settlement) => monthInRange(settlement.month ?? null, settlement.year ?? null))
+    .reduce((sum, settlement) => sum + settlement.amount_cents, 0);
+  const expenses = store.expenses
+    .filter((expense) => monthInRange(expense.month ?? null, expense.year ?? null))
+    .reduce((sum, expense) => sum + expense.amount_cents, 0);
+
+  const monthly_breakdown: MonthlyBreakdown[] = monthsBetween(from, to).map(({ month, year: y }) => {
+    const revenue_cents = paymentsInRange
+      .filter((payment) => {
+        const [paymentYear, paymentMonth] = isoDay(payment.created_at).split('-').map(Number);
+        return paymentYear === y && paymentMonth === month;
+      })
+      .reduce((sum, payment) => sum + payment.amount_cents, 0);
+    const expenses_cents = store.expenses
+      .filter((expense) => expense.month === month && expense.year === y)
+      .reduce((sum, expense) => sum + expense.amount_cents, 0);
+    const compensation_cents = store.teacherSettlements
+      .filter((settlement) => settlement.month === month && settlement.year === y)
+      .reduce((sum, settlement) => sum + settlement.amount_cents, 0);
+    return {
+      month,
+      year: y,
+      month_name: FRENCH_MONTHS[month - 1] ?? '',
+      revenue_cents,
+      expenses_cents,
+      compensation_cents,
+      net_cents: revenue_cents - compensation_cents - expenses_cents,
+    };
+  });
+
+  const top_groups: TopGroup[] = yearGroups
+    .map((group) => {
+      const enrollmentIds = new Set(
+        store.enrollments
+          .filter((enrollment) => enrollment.group_id === group.id)
+          .map((enrollment) => enrollment.id),
+      );
+      const invoiceIds = new Set(
+        store.invoices
+          .filter((invoice) => enrollmentIds.has(invoice.enrollment_id))
+          .map((invoice) => invoice.id),
+      );
+      const revenue_cents = paymentsInRange
+        .filter((payment) => payment.invoice_id !== null && invoiceIds.has(payment.invoice_id))
+        .reduce((sum, payment) => sum + payment.amount_cents, 0);
+      const row = groupRow(store, group);
+      return {
+        group_id: group.id,
+        name: row.branch_name
+          ? `${row.subject_name} — ${row.level_name} ${row.branch_name}`
+          : `${row.subject_name} — ${row.level_name}`,
+        revenue_cents,
+        enrolled_count: store.enrollments.filter(
+          (enrollment) => enrollment.group_id === group.id && enrollment.status === 'actif',
+        ).length,
+      };
+    })
+    .sort((a, b) => b.revenue_cents - a.revenue_cents || a.name.localeCompare(b.name, 'fr'))
+    .slice(0, 5);
+
+  const paidByStudent = new Map<number, number>();
+  paymentsInRange.forEach((payment) => {
+    if (payment.student_id === null) return;
+    paidByStudent.set(
+      payment.student_id,
+      (paidByStudent.get(payment.student_id) ?? 0) + payment.amount_cents,
+    );
+  });
+  const top_students: TopStudent[] = [...paidByStudent.entries()]
+    .map(([studentId, total]) => ({
+      student_id: studentId,
+      name: store.students.find((student) => student.id === studentId)?.full_name ?? '—',
+      total_paid_cents: total,
+    }))
+    .sort((a, b) => b.total_paid_cents - a.total_paid_cents || a.name.localeCompare(b.name, 'fr'))
+    .slice(0, 10);
+
+  const net = revenue - compensation - expenses;
+  return {
+    year,
+    total_students: totalStudents,
+    total_groups: yearGroups.length,
+    total_revenue_cents: revenue,
+    total_theoretical_cents: theoretical,
+    collection_rate:
+      theoretical > 0 ? Math.round((revenue / theoretical) * 10_000) / 100 : 0,
+    total_compensation_cents: compensation,
+    total_expenses_cents: expenses,
+    net_income_cents: net,
+    monthly_breakdown,
+    top_groups,
+    top_students,
+  };
+}
