diff --git a/src/components/settings/RentreeWizardModal.tsx b/src/components/settings/RentreeWizardModal.tsx
new file mode 100644
index 0000000..7b67f56
--- /dev/null
+++ b/src/components/settings/RentreeWizardModal.tsx
@@ -0,0 +1,647 @@
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { AlertTriangle, CheckCircle2, GraduationCap, Rocket } from 'lucide-react';
+import Button from '../ui/Button';
+import Input from '../ui/Input';
+import Modal from '../ui/Modal';
+import { toast } from '../ui/Toast';
+import { schoolYearsApi } from '../../services/settings';
+import { rentreeApi } from '../../services/schoolYear';
+import { cn, formatCurrency, formatDate } from '../../utils/format';
+import type {
+  RentreeGroupSummary,
+  RentreePreview,
+  RentreeResult,
+  RentreeStudentSummary,
+  SchoolYear,
+} from '../../types';
+
+export interface RentreeWizardModalProps {
+  open: boolean;
+  onClose: () => void;
+  /** Called after a successful transition so the settings page can refresh. */
+  onDone?: () => void;
+}
+
+type Step = 1 | 2 | 3 | 4;
+
+/** `2024-2025` → `2025-2026`; falls back to the calendar. */
+function suggestLabel(years: SchoolYear[]): string {
+  const starts = years
+    .map((year) => Number((year.start_date ?? '').slice(0, 4)))
+    .filter((value) => Number.isFinite(value) && value > 2000);
+  const base = starts.length > 0 ? Math.max(...starts) : new Date().getFullYear();
+  return `${base + 1}-${base + 2}`;
+}
+
+function suggestStart(years: SchoolYear[]): string {
+  const label = suggestLabel(years);
+  return `${label.slice(0, 4)}-09-01`;
+}
+
+function suggestEnd(years: SchoolYear[]): string {
+  const label = suggestLabel(years);
+  return `${label.slice(5, 9)}-06-30`;
+}
+
+/**
+ * “Nouvelle rentrée” — the four-step school-year transition.
+ *
+ * 1. the new year (label + dates, validated before anything else);
+ * 2. the groups to carry over (pre-ticked);
+ * 3. the students to re-enroll (pre-ticked, searchable) and the date of the
+ *    new enrollments;
+ * 4. a summary with the *estimated* number of enrollments and invoices, then
+ *    the result of the single transaction the backend runs.
+ *
+ * Nothing is written before step 4: the first three steps only read.
+ */
+export function RentreeWizardModal({ open, onClose, onDone }: RentreeWizardModalProps) {
+  const { t } = useTranslation();
+
+  const [step, setStep] = useState<Step>(1);
+  const [years, setYears] = useState<SchoolYear[]>([]);
+  const [preview, setPreview] = useState<RentreePreview | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [submitting, setSubmitting] = useState(false);
+  const [result, setResult] = useState<RentreeResult | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const [label, setLabel] = useState('');
+  const [startDate, setStartDate] = useState('');
+  const [endDate, setEndDate] = useState('');
+  const [enrollmentDate, setEnrollmentDate] = useState('');
+  const [groupIds, setGroupIds] = useState<number[]>([]);
+  const [studentIds, setStudentIds] = useState<number[]>([]);
+  const [search, setSearch] = useState('');
+
+  const reset = useCallback(
+    (yearList: SchoolYear[]) => {
+      setStep(1);
+      setResult(null);
+      setError(null);
+      setSearch('');
+      setLabel(suggestLabel(yearList));
+      setStartDate(suggestStart(yearList));
+      setEndDate(suggestEnd(yearList));
+      setEnrollmentDate(suggestStart(yearList));
+      setGroupIds([]);
+      setStudentIds([]);
+    },
+    [],
+  );
+
+  // Load the current year + everything it holds when the wizard opens.
+  useEffect(() => {
+    if (!open) return;
+    let active = true;
+    setLoading(true);
+    setPreview(null);
+    schoolYearsApi
+      .list()
+      .then(async (yearList) => {
+        if (!active) return;
+        setYears(yearList);
+        reset(yearList);
+        const current = yearList.find((year) => year.is_active) ?? yearList[0] ?? null;
+        if (!current) {
+          setError(t('rentree.noYear'));
+          return;
+        }
+        const data = await rentreeApi.preview(current.id);
+        if (!active) return;
+        setPreview(data);
+        // Everything is opt-in but pre-ticked: the director unticks what stays behind.
+        setGroupIds(data.active_groups.map((group) => group.id));
+        setStudentIds(data.active_students.map((student) => student.id));
+      })
+      .catch((caught: unknown) => {
+        if (!active) return;
+        setError(caught instanceof Error ? caught.message : String(caught));
+      })
+      .finally(() => {
+        if (active) setLoading(false);
+      });
+    return () => {
+      active = false;
+    };
+    // `reset` and `t` are stable enough for one opening.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [open]);
+
+  const groups: RentreeGroupSummary[] = preview?.active_groups ?? [];
+  const students: RentreeStudentSummary[] = preview?.active_students ?? [];
+
+  const visibleStudents = useMemo(() => {
+    const needle = search.trim().toLowerCase();
+    if (!needle) return students;
+    return students.filter(
+      (student) =>
+        student.full_name.toLowerCase().includes(needle) ||
+        student.phone.includes(needle) ||
+        (student.level_name ?? '').toLowerCase().includes(needle),
+    );
+  }, [search, students]);
+
+  const selectedGroups = useMemo(
+    () => groups.filter((group) => groupIds.includes(group.id)),
+    [groupIds, groups],
+  );
+
+  /** Enrollments the current selection will create, and their first invoices. */
+  const estimate = useMemo(() => {
+    let enrollments = 0;
+    let cents = 0;
+    students
+      .filter((student) => studentIds.includes(student.id))
+      .forEach((student) => {
+        student.group_ids.forEach((groupId) => {
+          if (!groupIds.includes(groupId)) return;
+          enrollments += 1;
+          cents += groups.find((group) => group.id === groupId)?.monthly_fee_cents ?? 0;
+        });
+      });
+    return {
+      enrollments,
+      invoices: enrollments,
+      cents,
+      students: students.filter((student) => studentIds.includes(student.id)).length,
+    };
+  }, [groupIds, groups, studentIds, students]);
+
+  // -- step 1 validation ----------------------------------------------------
+  const step1Error = useMemo(() => {
+    if (!label.trim()) return t('settings.schoolYear.labelRequired');
+    if (years.some((year) => (year.label ?? '').trim() === label.trim())) {
+      return t('settings.schoolYear.exists');
+    }
+    if (!startDate || !endDate) return t('settings.schoolYear.datesRequired');
+    if (endDate <= startDate) return t('settings.schoolYear.invalidDates');
+    return null;
+  }, [endDate, label, startDate, t, years]);
+
+  const step3Error = useMemo(() => {
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(enrollmentDate)) return t('rentree.invalidDate');
+    if (studentIds.length > 0 && enrollmentDate < startDate) {
+      return t('rentree.dateBeforeYear');
+    }
+    return null;
+  }, [enrollmentDate, startDate, studentIds.length, t]);
+
+  const toggleGroup = (id: number) =>
+    setGroupIds((current) =>
+      current.includes(id) ? current.filter((value) => value !== id) : [...current, id],
+    );
+
+  const toggleStudent = (id: number) =>
+    setStudentIds((current) =>
+      current.includes(id) ? current.filter((value) => value !== id) : [...current, id],
+    );
+
+  const handleConfirm = async () => {
+    setSubmitting(true);
+    setError(null);
+    try {
+      const summary = await rentreeApi.execute({
+        new_label: label.trim(),
+        new_start: startDate,
+        new_end: endDate,
+        group_ids: groupIds,
+        student_ids: studentIds,
+        enrollment_date: enrollmentDate,
+      });
+      setResult(summary);
+      onDone?.();
+      toast.success(t('rentree.successToast', { year: label.trim() }));
+    } catch (caught) {
+      const message = caught instanceof Error ? caught.message : String(caught);
+      setError(message);
+      toast.error(message);
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const stepTitles = [
+    t('rentree.step1'),
+    t('rentree.step2'),
+    t('rentree.step3'),
+    t('rentree.step4'),
+  ];
+
+  const footer = result ? (
+    <Button onClick={onClose} data-testid="rentree-close">
+      {t('common.close')}
+    </Button>
+  ) : (
+    <>
+      <Button variant="secondary" onClick={onClose} disabled={submitting}>
+        {t('common.cancel')}
+      </Button>
+      {step > 1 ? (
+        <Button
+          variant="secondary"
+          onClick={() => setStep((current) => (current - 1) as Step)}
+          disabled={submitting}
+          data-testid="rentree-previous"
+        >
+          {t('common.previous')}
+        </Button>
+      ) : null}
+      {step < 4 ? (
+        <Button
+          onClick={() => setStep((current) => (current + 1) as Step)}
+          disabled={
+            (step === 1 && Boolean(step1Error)) ||
+            (step === 2 && groupIds.length === 0) ||
+            (step === 3 && (Boolean(step3Error) || studentIds.length === 0))
+          }
+          data-testid="rentree-next"
+        >
+          {t('common.next')}
+        </Button>
+      ) : (
+        <Button
+          onClick={() => void handleConfirm()}
+          loading={submitting}
+          disabled={submitting}
+          data-testid="rentree-confirm"
+        >
+          {t('rentree.confirm')}
+        </Button>
+      )}
+    </>
+  );
+
+  return (
+    <Modal
+      open={open}
+      onClose={submitting ? () => undefined : onClose}
+      size="xl"
+      testId="rentree-wizard"
+      title={
+        <span className="flex items-center gap-2">
+          <Rocket className="h-4 w-4 text-primary" aria-hidden="true" />
+          {t('rentree.title')}
+        </span>
+      }
+      description={result ? t('rentree.result.subtitle') : stepTitles[step - 1]}
+      footer={footer}
+    >
+      {loading ? (
+        <p className="py-8 text-center text-[13px] text-muted">{t('common.loading')}</p>
+      ) : result ? (
+        // ------------------------------------------------------- result ----
+        <div className="space-y-4 py-2 text-center" data-testid="rentree-result">
+          <CheckCircle2 className="mx-auto h-12 w-12 text-success" aria-hidden="true" />
+          <div>
+            <p className="text-h2 font-semibold text-foreground">{t('rentree.result.title')}</p>
+            <p className="mt-1 text-[13px] text-muted">
+              {t('rentree.result.yearCreated', { year: label.trim() })}
+            </p>
+          </div>
+          <ul className="mx-auto grid max-w-lg gap-2 text-start text-[13px]">
+            <li className="flex items-center justify-between rounded-md border border-border px-3 py-2">
+              <span className="text-muted">{t('rentree.result.groups')}</span>
+              <span className="font-semibold text-foreground" data-testid="rentree-result-groups">
+                {result.groups_created}
+              </span>
+            </li>
+            <li className="flex items-center justify-between rounded-md border border-border px-3 py-2">
+              <span className="text-muted">{t('rentree.result.students')}</span>
+              <span className="font-semibold text-foreground" data-testid="rentree-result-students">
+                {result.students_reenrolled}
+              </span>
+            </li>
+            <li className="flex items-center justify-between rounded-md border border-border px-3 py-2">
+              <span className="text-muted">{t('rentree.result.enrollments')}</span>
+              <span
+                className="font-semibold text-foreground"
+                data-testid="rentree-result-enrollments"
+              >
+                {result.enrollments_created}
+              </span>
+            </li>
+            <li className="flex items-center justify-between rounded-md border border-border px-3 py-2">
+              <span className="text-muted">{t('rentree.result.invoices')}</span>
+              <span className="font-semibold text-foreground" data-testid="rentree-result-invoices">
+                {result.invoices_generated}
+              </span>
+            </li>
+          </ul>
+        </div>
+      ) : error && !preview ? (
+        <p className="py-8 text-center text-[13px] text-destructive" role="alert">
+          {error}
+        </p>
+      ) : (
+        <div className="space-y-4">
+          {/* step indicator */}
+          <ol className="flex flex-wrap items-center gap-2 text-[12px]" data-testid="rentree-steps">
+            {stepTitles.map((title, index) => {
+              const number = (index + 1) as Step;
+              return (
+                <li
+                  key={title}
+                  className={cn(
+                    'flex items-center gap-1.5 rounded-full border px-2.5 py-1',
+                    number === step
+                      ? 'border-primary/40 bg-primary/10 font-medium text-primary'
+                      : number < step
+                        ? 'border-success/30 bg-success/10 text-success'
+                        : 'border-border text-muted',
+                  )}
+                >
+                  <span className="font-semibold">{number}</span>
+                  <span>{title}</span>
+                </li>
+              );
+            })}
+          </ol>
+
+          {error ? (
+            <p className="rounded-md border border-destructive/30 bg-destructive/5 px-3 py-2 text-[13px] text-destructive" role="alert">
+              {error}
+            </p>
+          ) : null}
+
+          {/* -------------------------------------------------- step 1 ---- */}
+          {step === 1 ? (
+            <div className="space-y-4" data-testid="rentree-step-1">
+              <div className="grid gap-3 sm:grid-cols-3">
+                <Input
+                  label={t('rentree.yearLabel')}
+                  required
+                  value={label}
+                  onChange={(event) => setLabel(event.target.value)}
+                  placeholder="2025-2026"
+                  data-testid="rentree-label"
+                  error={label ? undefined : t('settings.schoolYear.labelRequired')}
+                />
+                <Input
+                  label={t('rentree.startDate')}
+                  required
+                  type="date"
+                  value={startDate}
+                  onChange={(event) => {
+                    const next = event.target.value;
+                    // The enrollment date follows the start date until the
+                    // director types their own.
+                    setEnrollmentDate((current) => (current === startDate ? next : current));
+                    setStartDate(next);
+                  }}
+                  data-testid="rentree-start"
+                />
+                <Input
+                  label={t('rentree.endDate')}
+                  required
+                  type="date"
+                  value={endDate}
+                  onChange={(event) => setEndDate(event.target.value)}
+                  data-testid="rentree-end"
+                />
+              </div>
+              {step1Error ? (
+                <p className="text-[13px] text-destructive" role="alert" data-testid="rentree-error">
+                  {step1Error}
+                </p>
+              ) : null}
+              <div className="rounded-md border border-border bg-background px-3 py-2 text-[13px] text-muted">
+                {t('rentree.currentYear', {
+                  year: preview?.current_year.label ?? '—',
+                  start: formatDate(preview?.current_year.start_date),
+                  end: formatDate(preview?.current_year.end_date),
+                })}
+              </div>
+            </div>
+          ) : null}
+
+          {/* -------------------------------------------------- step 2 ---- */}
+          {step === 2 ? (
+            <div className="space-y-3" data-testid="rentree-step-2">
+              <div className="flex flex-wrap items-center justify-between gap-2">
+                <p className="text-[13px] text-muted">{t('rentree.groupsHint')}</p>
+                <div className="flex gap-2">
+                  <Button
+                    size="sm"
+                    variant="ghost"
+                    onClick={() => setGroupIds(groups.map((group) => group.id))}
+                    data-testid="rentree-groups-all"
+                  >
+                    {t('rentree.selectAll')}
+                  </Button>
+                  <Button
+                    size="sm"
+                    variant="ghost"
+                    onClick={() => setGroupIds([])}
+                    data-testid="rentree-groups-none"
+                  >
+                    {t('rentree.deselectAll')}
+                  </Button>
+                </div>
+              </div>
+
+              <ul className="divide-y divide-border rounded-md border border-border">
+                {groups.length === 0 ? (
+                  <li className="px-3 py-6 text-center text-[13px] text-muted">
+                    {t('rentree.noGroups')}
+                  </li>
+                ) : null}
+                {groups.map((group) => (
+                  <li key={group.id}>
+                    <label
+                      className="flex cursor-pointer items-center gap-3 px-3 py-2 hover:bg-background"
+                      data-testid={`rentree-group-${group.id}`}
+                    >
+                      <input
+                        type="checkbox"
+                        className="h-4 w-4 accent-primary"
+                        checked={groupIds.includes(group.id)}
+                        onChange={() => toggleGroup(group.id)}
+                        data-testid={`rentree-group-${group.id}-toggle`}
+                      />
+                      <span className="min-w-0 flex-1">
+                        <span className="block truncate text-[13px] font-medium text-foreground" dir="auto">
+                          {group.subject_name} — {group.level_name}
+                          {group.teacher_name ? (
+                            <span className="font-normal text-muted"> ({group.teacher_name})</span>
+                          ) : null}
+                        </span>
+                        <span className="mt-0.5 block text-[12px] text-muted">
+                          {group.schedule_text || '—'} · {formatCurrency(group.monthly_fee_cents)}
+                        </span>
+                      </span>
+                      <span className="shrink-0 text-[12px] text-muted">
+                        {t('rentree.enrolledShort', { count: group.enrolled_count })}
+                      </span>
+                    </label>
+                  </li>
+                ))}
+              </ul>
+
+              <p className="text-[13px] font-medium text-foreground" data-testid="rentree-groups-count">
+                {t('rentree.groupsCount', { selected: groupIds.length, total: groups.length })}
+              </p>
+            </div>
+          ) : null}
+
+          {/* -------------------------------------------------- step 3 ---- */}
+          {step === 3 ? (
+            <div className="space-y-3" data-testid="rentree-step-3">
+              <div className="flex flex-wrap items-center justify-between gap-2">
+                <p className="max-w-[420px] text-[13px] text-muted">{t('rentree.studentsHint')}</p>
+                <div className="flex gap-2">
+                  <Button
+                    size="sm"
+                    variant="ghost"
+                    onClick={() => setStudentIds(students.map((student) => student.id))}
+                    data-testid="rentree-students-all"
+                  >
+                    {t('rentree.selectAll')}
+                  </Button>
+                  <Button
+                    size="sm"
+                    variant="ghost"
+                    onClick={() => setStudentIds([])}
+                    data-testid="rentree-students-none"
+                  >
+                    {t('rentree.deselectAll')}
+                  </Button>
+                </div>
+              </div>
+
+              <div className="grid gap-3 sm:grid-cols-2">
+                <Input
+                  placeholder={t('rentree.searchStudent')}
+                  value={search}
+                  onChange={(event) => setSearch(event.target.value)}
+                  aria-label={t('rentree.searchStudent')}
+                  data-testid="rentree-student-search"
+                />
+                <Input
+                  label={t('rentree.enrollmentDate')}
+                  type="date"
+                  value={enrollmentDate}
+                  onChange={(event) => setEnrollmentDate(event.target.value)}
+                  data-testid="rentree-enrollment-date"
+                  error={step3Error ?? undefined}
+                />
+              </div>
+
+              <ul className="max-h-[280px] divide-y divide-border overflow-y-auto rounded-md border border-border">
+                {visibleStudents.length === 0 ? (
+                  <li className="px-3 py-6 text-center text-[13px] text-muted">
+                    {t('rentree.noStudents')}
+                  </li>
+                ) : null}
+                {visibleStudents.map((student) => (
+                  <li key={student.id}>
+                    <label
+                      className="flex cursor-pointer items-center gap-3 px-3 py-2 hover:bg-background"
+                      data-testid={`rentree-student-${student.id}`}
+                    >
+                      <input
+                        type="checkbox"
+                        className="h-4 w-4 accent-primary"
+                        checked={studentIds.includes(student.id)}
+                        onChange={() => toggleStudent(student.id)}
+                        data-testid={`rentree-student-${student.id}-toggle`}
+                      />
+                      <span className="min-w-0 flex-1">
+                        <span className="block truncate text-[13px] font-medium text-foreground" dir="auto">
+                          {student.full_name}
+                          {student.level_name ? (
+                            <span className="font-normal text-muted"> · {student.level_name}</span>
+                          ) : null}
+                        </span>
+                        <span className="mt-0.5 block truncate text-[12px] text-muted" dir="auto">
+                          {student.current_groups || '—'}
+                        </span>
+                      </span>
+                    </label>
+                  </li>
+                ))}
+              </ul>
+
+              <p className="text-[13px] font-medium text-foreground" data-testid="rentree-students-count">
+                {t('rentree.studentsCount', {
+                  selected: studentIds.length,
+                  total: students.length,
+                })}
+              </p>
+
+              <div className="flex items-start gap-2 rounded-md border border-warning/40 bg-warning/5 px-3 py-2 text-[13px] text-foreground">
+                <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0 text-warning" aria-hidden="true" />
+                <span>
+                  {t('rentree.warning')}{' '}
+                  <span className="font-semibold" data-testid="rentree-estimate">
+                    {t('rentree.estimatedTotal')}: {formatCurrency(estimate.cents)} ·{' '}
+                    {t('rentree.estimatedInvoices', { count: estimate.invoices })}
+                  </span>
+                </span>
+              </div>
+            </div>
+          ) : null}
+
+          {/* -------------------------------------------------- step 4 ---- */}
+          {step === 4 ? (
+            <div className="space-y-3" data-testid="rentree-step-4">
+              <ul className="divide-y divide-border rounded-md border border-border text-[13px]">
+                <li className="flex items-center justify-between gap-3 px-3 py-2">
+                  <span className="text-muted">{t('rentree.newYear')}</span>
+                  <span className="font-medium text-foreground" data-testid="rentree-summary-year">
+                    {label.trim()} ({formatDate(startDate)} → {formatDate(endDate)})
+                  </span>
+                </li>
+                <li className="flex items-center justify-between gap-3 px-3 py-2">
+                  <span className="text-muted">{t('rentree.result.groups')}</span>
+                  <span className="font-medium text-foreground" data-testid="rentree-summary-groups">
+                    {groupIds.length}
+                  </span>
+                </li>
+                <li className="flex items-center justify-between gap-3 px-3 py-2">
+                  <span className="text-muted">{t('rentree.result.students')}</span>
+                  <span className="font-medium text-foreground" data-testid="rentree-summary-students">
+                    {estimate.students}
+                  </span>
+                </li>
+                <li className="flex items-center justify-between gap-3 px-3 py-2">
+                  <span className="text-muted">{t('rentree.result.enrollments')}</span>
+                  <span
+                    className="font-medium text-foreground"
+                    data-testid="rentree-summary-enrollments"
+                  >
+                    {estimate.enrollments}
+                  </span>
+                </li>
+                <li className="flex items-center justify-between gap-3 px-3 py-2">
+                  <span className="text-muted">{t('rentree.result.invoices')}</span>
+                  <span className="font-medium text-foreground" data-testid="rentree-summary-invoices">
+                    {estimate.invoices} · {formatCurrency(estimate.cents)}
+                  </span>
+                </li>
+                <li className="flex items-center justify-between gap-3 px-3 py-2">
+                  <span className="text-muted">{t('rentree.enrollmentDate')}</span>
+                  <span className="font-medium text-foreground">
+                    {formatDate(enrollmentDate)}
+                  </span>
+                </li>
+              </ul>
+
+              <div className="flex items-start gap-2 rounded-md border border-border bg-background px-3 py-2 text-[12px] text-muted">
+                <GraduationCap className="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
+                <span>{t('rentree.confirmHint')}</span>
+              </div>
+
+              {selectedGroups.length === 0 || estimate.enrollments === 0 ? (
+                <p className="text-[12px] text-warning">{t('rentree.nothingToEnroll')}</p>
+              ) : null}
+            </div>
+          ) : null}
+        </div>
+      )}
+    </Modal>
+  );
+}
+
+export default RentreeWizardModal;
