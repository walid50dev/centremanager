+import { api, isTauri } from './api';
+import { devInvoke } from './settingsDevBackend';
+import type { BilanData, RentreeInput, RentreePreview, RentreeResult } from '../types';
+
+/**
+ * Typed wrappers for the Phase 14 commands
+ * (`src-tauri/src/commands/rentree.rs`, `bilan.rs`).
+ *
+ * In a browser (`npm run dev`, no Tauri IPC) the calls are served by the
+ * development store in `settingsDevBackend.ts`.
+ */
+const USE_DEV_BACKEND = import.meta.env.DEV && !isTauri();
+
+async function call<T>(cmd: string, args?: Record<string, unknown>): Promise<T> {
+  if (USE_DEV_BACKEND) return devInvoke(cmd, args) as Promise<T>;
+  return api<T>(cmd, args);
+}
+
+export const rentreeApi = {
+  /** Groups, students and teachers of the year that is about to be closed. */
+  preview: (currentYearId: number) =>
+    call<RentreePreview>('cmd_get_rentree_preview', { currentYearId }),
+
+  /** One transaction: new year, copied groups, fresh enrollments + invoices. */
+  execute: (data: RentreeInput) => call<RentreeResult>('cmd_execute_rentree', { data }),
+};
+
+export const bilanApi = {
+  /** Every number of one school year. */
+  get: (yearId: number) => call<BilanData>('cmd_get_bilan', { yearId }),
+};
+
+export default rentreeApi;
