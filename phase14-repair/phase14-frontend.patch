new file mode 100644
index 0000000..860b45f
--- /dev/null
+++ b/src/pages/BilanPage.tsx
@@ -0,0 +1,426 @@
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import {
+  BarChart3,
+  BookOpen,
+  Building2,
+  Gem,
+  Percent,
+  Star,
+  Trophy,
+  Target,
+  TrendingUp,
+  Users,
+  Wallet,
+} from 'lucide-react';
+import Button from '../components/ui/Button';
+import Card from '../components/ui/Card';
+import EmptyState from '../components/ui/EmptyState';
+import Select from '../components/ui/Select';
+import GroupDetailModal from '../components/groups/GroupDetailModal';
+import { toast } from '../components/ui/Toast';
+import { schoolYearsApi } from '../services/settings';
+import { bilanApi } from '../services/schoolYear';
+import { cn, formatCurrency, formatDate } from '../utils/format';
+import type { BilanData, SchoolYear } from '../types';
+
+/**
+ * “Bilan annuel” (`/bilan`, Phase 14).
+ *
+ * One read-only screen per school year: the eight headline numbers, the month
+ * by month table (with a stacked bar drawn in CSS — no chart library), the most
+ * profitable groups and the best payers. The year selector defaults to the
+ * active year; any other year can be replayed.
+ */
+export function BilanPage() {
+  const { t } = useTranslation();
+
+  const [years, setYears] = useState<SchoolYear[]>([]);
+  const [yearId, setYearId] = useState<string>('');
+  const [data, setData] = useState<BilanData | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [detailGroupId, setDetailGroupId] = useState<number | null>(null);
+
+  // School years first: the default is the active one, else the most recent.
+  useEffect(() => {
+    let active = true;
+    schoolYearsApi
+      .list()
+      .then((rows) => {
+        if (!active) return;
+        setYears(rows);
+        const initial = rows.find((year) => year.is_active) ?? rows[0] ?? null;
+        setYearId(initial ? String(initial.id) : '');
+      })
+      .catch((error: unknown) => {
+        toast.error(error instanceof Error ? error.message : String(error));
+        setLoading(false);
+      });
+    return () => {
+      active = false;
+    };
+  }, []);
+
+  const load = useCallback(async (id: string) => {
+    if (!id) {
+      setData(null);
+      setLoading(false);
+      return;
+    }
+    setLoading(true);
+    try {
+      setData(await bilanApi.get(Number(id)));
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : String(error));
+      setData(null);
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    void load(yearId);
+  }, [load, yearId]);
+
+  const refresh = useCallback(() => void load(yearId), [load, yearId]);
+
+  const monthName = useCallback(
+    (month: number, fallback: string) => t(`common.months.${month}`, { defaultValue: fallback }),
+    [t],
+  );
+
+  /** Largest absolute monthly total, used to scale the CSS bars. */
+  const maxMonthly = useMemo(() => {
+    const rows = data?.monthly_breakdown ?? [];
+    return rows.reduce(
+      (max, row) => Math.max(max, row.revenue_cents, row.expenses_cents + row.compensation_cents),
+      0,
+    );
+  }, [data]);
+
+  const netPositive = (data?.net_income_cents ?? 0) >= 0;
+  const rate = data?.collection_rate ?? 0;
+
+  const kpis = data
+    ? [
+        {
+          key: 'students',
